# Server
HOST=0.0.0.0
PORT=3002

# Database (SeaORM)
# postgres://USER:PASSWORD@HOST:5432/DB_NAME
# mysql://USER:PASSWORD@HOST:3306/DB_NAME
# sqlite://path/to/db.sqlite?mode=rwc
DATABASE_URL=postgres://user:password@localhost:5432/axum_app

# Auth / cookies (COOKIE_KEY must be >= 64 characters in production)
COOKIE_KEY=dev-only-change-me-to-a-string-that-is-at-least-sixty-four-chars-long
COOKIE_SECURE=false
SESSION_TTL_HOURS=168

# Comma-separated browser origins allowed to call the API with credentials
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3002
